__pycache__/
*.pyc
*.log
.cache/
.idea/
_trash_*/
webapp/cache/
webapp/config/settings.json
webapp/config/embedding.json
webapp/config/paths.json
webapp/config/domains/
# MinerU 平台 key：无论放在 config/（新位置）还是 core/（旧位置）都不入库
mineru_key.txt
.workbuddy/
scripts/subscribe/lit_keywords.txt
archive/
docs/research/
# 交接/工作笔记属个人记录，不入库（2026-10-02 起移出跟踪）
docs/交接文档.md
# scripts/：只分发通用脚本；含个人研究内容或数据的文件继续排除
scripts/pipeline/*
!scripts/pipeline/build_pack.py
scripts/dedup/*
!scripts/dedup/dedup_plan.py
!scripts/dedup/zot_dedup.py
scripts/tags/*
!scripts/tags/tag_analysis.py
scripts/subscribe/lit_journals.txt
webapp/config/domain.json
# 期刊分区表：中科院 / JCR / 新锐 属**授权数据**，合并结果只留本机，绝不入库
webapp/config/journal_ranks.csv
notes/.gitkeep
reports/.gitkeep
notes/*
!notes/.gitkeep
reports/*
!reports/.gitkeep
# 通用构建产物目录（本项目当前不打包分发，保留以防哪天工具生成后被误提交）
dist/
build/

# 本机专用启动器：硬编码本机 Python 绝对路径，不随仓库分发。
# 通用入口仍是 webapp/start.bat（优先找 webapp/venv，找不到才回退 python）。
*.local.bat

# Python 虚拟环境：setup.bat 会在 webapp/ 下创建 venv（几百 MB，绝不能入库）
venv/
.venv/
